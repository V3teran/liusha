# Binaries
/bin/
cmd/*/dist/
*.exe
*.test
*.out

# Local env（根 .env = host 脚本 source + compose 插值的唯一真值文件；模板见 .env.example）
.env
# compose 本地覆盖（docker compose 自动加载同名文件，常含真实端口/密钥插值）
/compose.override.yaml
# 生产密钥（make prod-up 经 --env-file .env.prod 注入，含真实凭据，绝不入 git）
.env.prod
# .env 备份（含密钥，绝不入 git）
.env*.bak
.env*.bak-*

# Editor
.vscode/
.idea/
.DS_Store

# 前端构建产物（web/ 源码同仓，dist 由 nginx 镜像多阶段构建生成，不入 git）
web/dist/
web/node_modules/
# 根目录 node_modules（仅 vite 依赖缓存等游离产物；依赖本体在 web/ 并由 lock 复现）
/node_modules/

# Mimosa 安全扫描的本机状态（扫描历史/门禁基线/报告缓存，任意层级，可随时重建）
.mimosa/

# Coverage
coverage.out
coverage.html

# cmd/* 二进制在仓库根目录的游离副本（`go build ./cmd/<x>` 默认输出于此）
/api
/cmd/api/api
/corpus-import
/e2e
/proxy
/reseed
/runner
/sandbox-server

# 本地调试产物（截图、playwright MCP 转储）
/llm-view-*.png
/.playwright-mcp/

# Runtime logs / pids（host 进程 + proxify 流量 dump，每次 dev 启动覆盖）
/logs/
# 各 package 测试落盘的本地 log 目录（豁免前端源码目录）
**/logs/
!web/src/features/logs/

# Claude Code 本地会话状态
/.claude/

# sandbox build context 的 CA cert（运行时从 $HOME/.liusha/cacert.pem 同步进来，不入 git）
deployments/tool-images/sandbox/liusha-ca.crt

# Python 字节码缓存（browser-svc.py 等运行时生成）
__pycache__/
*.pyc

# 历史备份/一次性产物不入库
*.bak
*.backup
*.old

# ZCode 会话工作目录
/.zcode/
# ZCode 工具配置（本地态不入库）与治理配置（易与代码漂移，维持本地）
/.zcodeignore
$CLAUDE_JOB_DIR/
.v2c/

# 会话级工作日志（过程状态不入库；结论已沉淀 .agents/reports/）
.agents/pipeline-progress.md
