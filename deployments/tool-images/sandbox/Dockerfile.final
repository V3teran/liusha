# syntax=docker/dockerfile:1.7
# sandbox：liusha 沙箱镜像（基于 liusha-sandbox-base）
#
# 基于 liusha-sandbox-base 基础镜像，只添加：
#   - liusha 程序（Stage 0 编译，以 sandbox 子命令运行）
#   - browser-use/browser-svc.py 薄客户端脚本
#
# 构建时间：~2-3 分钟（base 镜像完全缓存）
# 镜像大小：与 base 相同 + liusha

# 全局 ARG（在所有 FROM 之前声明，才能在多个 stage 中使用）
ARG BASE_IMAGE=ghcr.io/v3teran/liusha-sandbox-base:latest

# ── Stage 0: 编译 liusha ─────────────────────────────────────────────────────
# $BUILDPLATFORM：编译段永远跑构建机原生架构，GOOS/GOARCH 交叉产出目标架构——
# 双平台构建（amd64+arm64）零 QEMU，与仓库根 Dockerfile 同一模式。
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS sandbox-builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY . .
ENV CGO_ENABLED=0
RUN GOOS=$TARGETOS GOARCH=$TARGETARCH go build -mod=vendor -trimpath -o /out/liusha ./cmd/liusha

# ── Stage 1: 基于 base 镜像构建最终镜像 ──────────────────────────────────────
# 在 stage 内部重新声明 ARG（multi-stage build 要求）
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Layer 7: browser-use 薄客户端（覆盖 base 中的占位符）
COPY deployments/tool-images/sandbox/browser-use /usr/local/bin/browser-use
COPY deployments/tool-images/sandbox/browser-svc.py /usr/local/bin/browser-svc.py
RUN chmod +x /usr/local/bin/browser-use /usr/local/bin/browser-svc.py

# Layer 12: uvx 入口——base 只装了 uv；browser_use 的 LocalBrowserWatchdog 启动浏览器时
# spawn `uvx`。uvx 真实语义 = `uv tool run`（uv 二进制按 argv[0] 分发，symlink 无效），用 wrapper。
RUN printf '%s\n' \
  '#!/bin/sh' \
  'exec /usr/local/bin/uv tool run "$@"' \
  > /usr/local/bin/uvx \
 && chmod +x /usr/local/bin/uvx

# chromium 预装在 base Layer 20（工具底座）；本层只做业务装配（uvx wrapper + liusha）。

# Layer 13: liusha（以 sandbox 子命令运行）
COPY --from=sandbox-builder /out/liusha /usr/local/bin/liusha

LABEL org.opencontainers.image.source="https://github.com/V3teran/liusha"

WORKDIR /work
ENV LIUSHA_SANDBOX_LISTEN_ADDR=0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/liusha"]
CMD ["sandbox"]
