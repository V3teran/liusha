# syntax=docker/dockerfile:1.4
# Pentools 基础镜像：Kali Linux + 90 个安全工具
# 架构：按安装方式分层，每层末尾强制验证，失败立即退出

FROM kalilinux/kali-rolling:latest

# 环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PIPX_HOME=/opt/pipx \
    PIPX_BIN_DIR=/usr/local/bin

# apt 重试配置（网络抖动不让整层 abort）
RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "120";\nAcquire::https::Timeout "120";\n' \
      > /etc/apt/apt.conf.d/80-retries

# ══════════════════════════════════════════════════════════════════════════════
# Layer 1: 基础环境 + 构建依赖
# ══════════════════════════════════════════════════════════════════════════════
ARG TARGETARCH
ENV TARGETARCH=${TARGETARCH}

RUN set -eux \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl wget git unzip xz-utils tar file \
      python3 python3-pip python3-venv pipx \
      nodejs npm \
      php-cli \
      golang maven \
      ruby-full \
      default-mysql-client postgresql-client \
      build-essential libssl-dev libffi-dev \
      libgmp-dev libmpfr-dev libmpc-dev \
      cmake pkg-config \
 && rm -rf /var/lib/apt/lists/* \
 && printf 'tries=5\nwaitretry=10\ntimeout=60\nretry-connrefused=on\n' >> /etc/wgetrc \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${TARGETARCH}" \
      -O /usr/local/bin/yq \
 && chmod +x /usr/local/bin/yq \
 && echo "=== Layer 1 验证：基础环境 ===" \
 && python3 --version \
 && command -v node \
 && command -v ruby \
 && go version \
 && command -v pipx \
 && command -v yq \
 && echo "✅ Layer 1: 基础环境安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 2: 双 JDK（Temurin 8 + 17）
# ══════════════════════════════════════════════════════════════════════════════
# Java 反序列化工具（ysomap/ysoserial）需要 JDK8，现代目标需要 JDK17
# 默认 java 指向 JDK8（兼容性最广），显式 java17 命令切换
RUN set -eux \
 && J_ARCH=x64 \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/adoptium/temurin8-binaries/releases/download/jdk8u352-b08/OpenJDK8U-jdk_${J_ARCH}_linux_hotspot_8u352b08.tar.gz" \
      -O /tmp/jdk8.tar.gz \
 && mkdir -p /opt/jdk8 \
 && tar -xzf /tmp/jdk8.tar.gz -C /opt/jdk8 --strip-components=1 \
 && rm /tmp/jdk8.tar.gz \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.19+10/OpenJDK17U-jdk_${J_ARCH}_linux_hotspot_17.0.19_10.tar.gz" \
      -O /tmp/jdk17.tar.gz \
 && mkdir -p /opt/jdk17 \
 && tar -xzf /tmp/jdk17.tar.gz -C /opt/jdk17 --strip-components=1 \
 && rm /tmp/jdk17.tar.gz \
 && for b in java javac keytool jar; do \
      update-alternatives --install "/usr/bin/$b" "$b" "/opt/jdk8/bin/$b" 800; \
      update-alternatives --install "/usr/bin/$b" "$b" "/opt/jdk17/bin/$b" 170; \
      update-alternatives --set "$b" "/opt/jdk8/bin/$b"; \
    done \
 && printf '#!/bin/sh\nexec /opt/jdk8/bin/java "$@"\n' > /usr/local/bin/java8 \
 && printf '#!/bin/sh\nexec /opt/jdk17/bin/java "$@"\n' > /usr/local/bin/java17 \
 && chmod +x /usr/local/bin/java8 /usr/local/bin/java17 \
 && echo "=== Layer 2 验证：JDK ===" \
 && command -v java 2>&1 | grep "1.8" \
 && java17 -version 2>&1 | grep "17.0.19" \
 && echo "✅ Layer 2: JDK 8 + 17 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 3: apt 工具（48 个）
# ══════════════════════════════════════════════════════════════════════════════
# Kali 官方源直供的工具，apt 一次装齐
RUN set -eux \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      nmap sqlmap hydra ffuf feroxbuster wafw00f arjun \
      subfinder httpx-toolkit nuclei \
      phpggc trufflehog \
      seclists \
      masscan netexec \
      nikto wpscan \
      commix \
      metasploit-framework \
      john hashcat hash-identifier fcrackzip \
      binwalk foremost exiftool testdisk \
      steghide stegseek \
      gdb radare2 strace ltrace \
      patchelf checksec \
      proxychains4 tshark responder \
      curl jq \
      ghidra \
 && rm -rf /var/lib/apt/lists/* \
 && echo "=== Layer 3 验证：apt 工具 ===" \
 && command -v nmap \
 && command -v sqlmap && command -v sqlmap \
 && command -v sqlmap && command -v sqlmap \
 && command -v hydra && hydra -h 2>&1 | head -1 \
 && command -v ffuf && command -v ffuf \
 && command -v feroxbuster && command -v feroxbuster \
 && command -v wafw00f && wafw00f --version \
 && command -v arjun \
 && command -v nuclei && command -v nuclei \
 && command -v phpggc && command -v phpggc \
 && command -v trufflehog && command -v trufflehog \
 && command -v masscan \
 && command -v netexec && command -v netexec \
 && command -v nikto && nikto -Version \
 && command -v wpscan && command -v wpscan \
 && command -v commix && command -v commix \
 && command -v msfconsole && command -v msfconsole \
 && command -v john && command -v john \
 && command -v hashcat && command -v hashcat \
 && command -v hash-identifier \
 && command -v fcrackzip && command -v fcrackzip \
 && command -v binwalk && command -v binwalk \
 && command -v foremost && command -v foremost \
 && command -v exiftool && command -v exiftool \
 && command -v testdisk && command -v testdisk \
 && command -v steghide && command -v steghide \
 && command -v stegseek && command -v stegseek \
 && command -v gdb && command -v gdb | head -1 \
 && command -v radare2 && radare2 -version \
 && command -v strace && command -v strace \
 && command -v ltrace && command -v ltrace \
 && command -v patchelf && command -v patchelf \
 && command -v checksec && command -v checksec \
 && command -v proxychains4 \
 && command -v tshark && command -v tshark | head -1 \
 && command -v responder && command -v responder \
 && command -v curl && command -v curl | head -1 \
 && command -v jq && command -v jq \
 && command -v ghidra && command -v ghidra \
 && echo "✅ Layer 3: apt 工具（48 个）安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 4: httpx 命名兼容 + PD 系工具 -duc wrapper
# ══════════════════════════════════════════════════════════════════════════════
# httpx: Kali 命令是 httpx-toolkit，包装成 /usr/local/bin/httpx（agent 调 httpx）
# nuclei/subfinder: 添加 -duc 参数，拦截 phone-home（api.pdtm.sh 版本检查）
RUN set -eux \
 && printf '#!/bin/sh\nexec httpx-toolkit -duc "$@"\n' > /usr/local/bin/httpx \
 && chmod +x /usr/local/bin/httpx \
 && for tool in nuclei subfinder; do \
      real=$(command -v "$tool") || { echo "❌ $tool 不存在"; exit 1; }; \
      mv "$real" "${real}.real"; \
      printf '#!/bin/sh\nexec %s.real -duc "$@"\n' "$real" > "$real"; \
      chmod +x "$real"; \
    done \
 && echo "=== Layer 4 验证：httpx + PD -duc ===" \
 && command -v httpx 2>&1 | head -1 \
 && command -v nuclei 2>&1 | head -1 \
 && command -v subfinder 2>&1 | head -1 \
 && echo "✅ Layer 4: httpx 命名 + PD -duc 完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 5: pip 工具（2 个）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && pip install --no-cache-dir --break-system-packages \
      semgrep \
      ROPgadget \
 && echo "=== Layer 5 验证：pip 工具 ===" \
 && command -v semgrep \
 && ROPgadget --version \
 && echo "✅ Layer 5: pip 工具安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 6: pipx 工具（7 个）
# ══════════════════════════════════════════════════════════════════════════════
# 隔离 Python CLI 工具，避免依赖冲突
RUN set -eux \
 && pipx install prowler \
 && pipx install pacu \
 && pipx install cloudsplaining \
 && pipx install checkov \
 && pipx install kube-hunter \
 && pipx install bloodhound-python \
 && pipx install certipy-ad \
 && echo "=== Layer 6 验证：pipx 工具 ===" \
 && command -v prowler \
 && command -v pacu \
 && command -v cloudsplaining \
 && command -v checkov \
 && command -v kube-hunter \
 && command -v bloodhound-python \
 && command -v certipy \
 && echo "✅ Layer 6: pipx 工具（7 个）安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 7: npm 工具（1 个）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && npm install -g @stoplight/spectral-cli \
 && echo "=== Layer 7 验证：npm 工具 ===" \
 && command -v spectral \
 && echo "✅ Layer 7: npm 工具安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 8: gem 工具（4 个）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && gem install one_gadget seccomp-tools evil-winrm zsteg \
 && echo "=== Layer 8 验证：gem 工具 ===" \
 && one_gadget --version \
 && command -v seccomp-tools \
 && command -v evil-winrm \
 && command -v zsteg \
 && echo "✅ Layer 8: gem 工具（4 个）安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 9: release 工具（5 个）- GitHub release 压缩包
# ══════════════════════════════════════════════════════════════════════════════
# katana, fscan, gau, interactsh-client, sliver
RUN set -eux \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/projectdiscovery/katana/releases/download/v1.6.1/katana_1.6.1_linux_${TARGETARCH}.zip" \
      -O /tmp/katana.zip \
 && unzip -oq /tmp/katana.zip katana -d /usr/local/bin/ \
 && chmod +x /usr/local/bin/katana \
 && rm /tmp/katana.zip \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/shadow1ng/fscan/releases/download/1.8.4/fscan_1.8.4_linux_${TARGETARCH}.zip" \
      -O /tmp/fscan.zip \
 && unzip -oq /tmp/fscan.zip fscan -d /usr/local/bin/ \
 && chmod +x /usr/local/bin/fscan \
 && rm /tmp/fscan.zip \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/lc/gau/releases/download/v2.2.4/gau_2.2.4_linux_${TARGETARCH}.tar.gz" \
      -O /tmp/gau.tar.gz \
 && tar -xzf /tmp/gau.tar.gz -C /usr/local/bin gau \
 && chmod +x /usr/local/bin/gau \
 && rm /tmp/gau.tar.gz \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/projectdiscovery/interactsh/releases/download/v1.3.1/interactsh-client_1.3.1_linux_${TARGETARCH}.zip" \
      -O /tmp/interactsh.zip \
 && unzip -oq /tmp/interactsh.zip interactsh-client -d /usr/local/bin/ \
 && chmod +x /usr/local/bin/interactsh-client \
 && rm /tmp/interactsh.zip \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/BishopFox/sliver/releases/download/v1.6.0/sliver-server_linux_${TARGETARCH}" \
      -O /usr/local/bin/sliver \
 && chmod +x /usr/local/bin/sliver \
 && echo "=== Layer 9 验证：release 工具 ===" \
 && command -v katana \
 && fscan -h 2>&1 | head -1 \
 && command -v gau \
 && command -v interactsh-client \
 && sliver version \
 && echo "✅ Layer 9: release 工具（5 个）安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 10: release-bin 工具（2 个）- GitHub release 单二进制
# ══════════════════════════════════════════════════════════════════════════════
# chisel, linpeas
RUN set -eux \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/jpillora/chisel/releases/download/v1.9.1/chisel_1.9.1_linux_${TARGETARCH}.gz" \
      -O /tmp/chisel.gz \
 && gunzip /tmp/chisel.gz \
 && mv /tmp/chisel /usr/local/bin/chisel \
 && chmod +x /usr/local/bin/chisel \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/carlospolop/PEASS-ng/releases/latest/download/linpeas.sh" \
      -O /usr/local/bin/linpeas \
 && chmod +x /usr/local/bin/linpeas \
 && echo "=== Layer 10 验证：release-bin 工具 ===" \
 && command -v chisel \
 && linpeas | head -5 \
 && echo "✅ Layer 10: release-bin 工具（2 个）安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 11: git 工具（1 个）
# ══════════════════════════════════════════════════════════════════════════════
# paramspider: git clone 后直接可用
RUN set -eux \
 && git clone --depth 1 https://github.com/devanshbatham/ParamSpider.git /opt/paramspider \
 && printf '#!/bin/sh\ncd /opt/paramspider && python3 paramspider.py "$@"\n' > /usr/local/bin/paramspider \
 && chmod +x /usr/local/bin/paramspider \
 && echo "=== Layer 11 验证：git 工具 ===" \
 && paramspider --help | head -5 \
 && echo "✅ Layer 11: git 工具安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 12: ysomap（Java 反序列化利用框架）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && git clone --depth 1 https://github.com/wh1t3p1g/ysomap.git /opt/ysomap \
 && cd /opt/ysomap \
 && mvn clean package -DskipTests \
 && printf '#!/bin/sh\nexec java -jar /opt/ysomap/target/ysomap.jar "$@"\n' > /usr/local/bin/ysomap \
 && chmod +x /usr/local/bin/ysomap \
 && echo "=== Layer 12 验证：ysomap ===" \
 && ysomap --help | head -5 \
 && echo "✅ Layer 12: ysomap 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 13: ysoserial（Java 反序列化经典 gadget）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/frohoff/ysoserial/releases/download/v0.0.6/ysoserial-all.jar" \
      -O /opt/ysoserial.jar \
 && printf '#!/bin/sh\nexec java -jar /opt/ysoserial.jar "$@"\n' > /usr/local/bin/ysoserial \
 && chmod +x /usr/local/bin/ysoserial \
 && echo "=== Layer 13 验证：ysoserial ===" \
 && ysoserial --help 2>&1 | head -5 \
 && echo "✅ Layer 13: ysoserial 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 14: jwt_tool（JWT 攻击）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && git clone --depth 1 https://github.com/ticarpi/jwt_tool.git /opt/jwt_tool \
 && pip install --no-cache-dir --break-system-packages -r /opt/jwt_tool/requirements.txt \
 && printf '#!/bin/sh\nexec python3 /opt/jwt_tool/jwt_tool.py "$@"\n' > /usr/local/bin/jwt_tool \
 && chmod +x /usr/local/bin/jwt_tool \
 && echo "=== Layer 14 验证：jwt_tool ===" \
 && jwt_tool --help | head -5 \
 && echo "✅ Layer 14: jwt_tool 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 15: dalfox（XSS 扫描器）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && DALFOX_ARCH=x86_64 \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/hahwul/dalfox/releases/download/v3.1.2/dalfox-v3.1.2-linux-${DALFOX_ARCH}-musl.tar.gz" \
      -O /tmp/dalfox.tar.gz \
 && tar -xzf /tmp/dalfox.tar.gz -C /tmp \
 && mv /tmp/dalfox /usr/local/bin/dalfox \
 && chmod +x /usr/local/bin/dalfox \
 && rm -rf /tmp/dalfox* \
 && echo "=== Layer 15 验证：dalfox ===" \
 && dalfox version \
 && echo "✅ Layer 15: dalfox 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 16: SSTImap（SSTI 模板注入）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && git clone --depth 1 https://github.com/vladko312/SSTImap.git /opt/SSTImap \
 && pip install --no-cache-dir --break-system-packages -r /opt/SSTImap/requirements.txt \
 && printf '#!/bin/sh\nexec python3 /opt/SSTImap/sstimap.py "$@"\n' > /usr/local/bin/SSTImap \
 && chmod +x /usr/local/bin/SSTImap \
 && echo "=== Layer 16 验证：SSTImap ===" \
 && SSTImap --help | head -5 \
 && echo "✅ Layer 16: SSTImap 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 17: SSRFmap（SSRF 利用）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && git clone --depth 1 https://github.com/swisskyrepo/SSRFmap.git /opt/SSRFmap \
 && pip install --no-cache-dir --break-system-packages -r /opt/SSRFmap/requirements.txt \
 && printf '#!/bin/sh\nexec python3 /opt/SSRFmap/ssrfmap.py "$@"\n' > /usr/local/bin/SSRFmap \
 && chmod +x /usr/local/bin/SSRFmap \
 && echo "=== Layer 17 验证：SSRFmap ===" \
 && SSRFmap --help | head -5 \
 && echo "✅ Layer 17: SSRFmap 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 18: RsaCtfTool（RSA 密码学攻击）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && git clone --depth 1 https://github.com/RsaCtfTool/RsaCtfTool.git /opt/RsaCtfTool \
 && apt-get update \
 && apt-get install -y --no-install-recommends libgmp-dev libmpfr-dev libmpc-dev \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir --break-system-packages gmpy2 \
 && pip install --no-cache-dir --break-system-packages -r /opt/RsaCtfTool/requirements.txt \
 && printf '#!/bin/sh\nexec python3 /opt/RsaCtfTool/RsaCtfTool.py "$@"\n' > /usr/local/bin/RsaCtfTool \
 && chmod +x /usr/local/bin/RsaCtfTool \
 && echo "=== Layer 18 验证：RsaCtfTool ===" \
 && RsaCtfTool --help | head -5 \
 && echo "✅ Layer 18: RsaCtfTool 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 19: angr（二进制符号执行）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && python3 -m venv /opt/angr-venv \
 && /opt/angr-venv/bin/pip install --no-cache-dir angr \
 && printf '#!/bin/sh\nexec /opt/angr-venv/bin/python "$@"\n' > /usr/local/bin/angr-python \
 && chmod +x /usr/local/bin/angr-python \
 && echo "=== Layer 19 验证：angr ===" \
 && angr-python -c "import angr; print(angr.__version__)" \
 && echo "✅ Layer 19: angr 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 20: browser-use（浏览器自动化）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && python3 -m venv /opt/browser-use-venv \
 && /opt/browser-use-venv/bin/pip install --no-cache-dir browser-use \
 && printf '#!/bin/sh\nexec /opt/browser-use-venv/bin/python -m browser_use "$@"\n' > /usr/local/bin/browser-use \
 && chmod +x /usr/local/bin/browser-use \
 && echo "=== Layer 20 验证：browser-use ===" \
 && /opt/browser-use-venv/bin/pip show browser-use | grep Version \
 && echo "✅ Layer 20: browser-use 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 21: stegoveritas（隐写分析）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && pip install --no-cache-dir --break-system-packages stegoveritas \
 && stegoveritas_install_deps \
 && echo "=== Layer 21 验证：stegoveritas ===" \
 && stegoveritas --help | head -5 \
 && echo "✅ Layer 21: stegoveritas 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 22: vol（Volatility 3 内存取证）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && pip install --no-cache-dir --break-system-packages volatility3 \
 && echo "=== Layer 22 验证：vol ===" \
 && vol --help | head -5 \
 && echo "✅ Layer 22: vol 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 23: peirates（K8s 渗透）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/inguardians/peirates/releases/download/v1.1.19/peirates-linux-${TARGETARCH}.tar.xz" \
      -O /tmp/peirates.tar.xz \
 && tar -xJf /tmp/peirates.tar.xz -C /usr/local/bin peirates \
 && chmod +x /usr/local/bin/peirates \
 && rm /tmp/peirates.tar.xz \
 && echo "=== Layer 23 验证：peirates ===" \
 && peirates --help | head -5 \
 && echo "✅ Layer 23: peirates 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 24: kube-bench（K8s CIS 基准测试）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/aquasecurity/kube-bench/releases/download/v0.9.1/kube-bench_0.9.1_linux_${TARGETARCH}.tar.gz" \
      -O /tmp/kube-bench.tar.gz \
 && tar -xzf /tmp/kube-bench.tar.gz -C /usr/local/bin kube-bench \
 && chmod +x /usr/local/bin/kube-bench \
 && rm /tmp/kube-bench.tar.gz \
 && echo "=== Layer 24 验证：kube-bench ===" \
 && kube-bench version \
 && echo "✅ Layer 24: kube-bench 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 25: kubectl
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && KUBECTL_ARCH=$([ "$TARGETARCH" = "amd64" ] && echo "amd64" || echo "arm64") \
 && wget -q --tries=3 --waitretry=5 \
      "https://dl.k8s.io/release/$(wget -qO- https://dl.k8s.io/release/stable.txt)/bin/linux/${KUBECTL_ARCH}/kubectl" \
      -O /usr/local/bin/kubectl \
 && chmod +x /usr/local/bin/kubectl \
 && echo "=== Layer 25 验证：kubectl ===" \
 && kubectl version --client \
 && echo "✅ Layer 25: kubectl 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 26: ligolo-ng（隧道代理）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/nicocha30/ligolo-ng/releases/download/v0.6.2/ligolo-ng_agent_0.6.2_linux_${TARGETARCH}.tar.gz" \
      -O /tmp/ligolo.tar.gz \
 && tar -xzf /tmp/ligolo.tar.gz -C /usr/local/bin agent \
 && mv /usr/local/bin/agent /usr/local/bin/ligolo-ng \
 && chmod +x /usr/local/bin/ligolo-ng \
 && rm /tmp/ligolo.tar.gz \
 && echo "=== Layer 26 验证：ligolo-ng ===" \
 && command -v ligolo-ng \
 && echo "✅ Layer 26: ligolo-ng 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 27: pwninit（pwn 题模板生成）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/io12/pwninit/releases/download/3.3.1/pwninit" \
      -O /usr/local/bin/pwninit \
 && chmod +x /usr/local/bin/pwninit \
 && echo "=== Layer 27 验证：pwninit ===" \
 && command -v pwninit \
 && echo "✅ Layer 27: pwninit 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 28: cloudfox（云安全枚举）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/BishopFox/cloudfox/releases/download/v1.14.2/cloudfox-linux-${TARGETARCH}" \
      -O /usr/local/bin/cloudfox \
 && chmod +x /usr/local/bin/cloudfox \
 && echo "=== Layer 28 验证：cloudfox ===" \
 && command -v cloudfox \
 && echo "✅ Layer 28: cloudfox 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 29: trivy（容器镜像扫描）
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && wget -q --tries=3 --waitretry=5 \
      "https://github.com/aquasecurity/trivy/releases/download/v0.58.1/trivy_0.58.1_Linux-64bit.tar.gz" \
      -O /tmp/trivy.tar.gz \
 && tar -xzf /tmp/trivy.tar.gz -C /usr/local/bin trivy \
 && chmod +x /usr/local/bin/trivy \
 && rm /tmp/trivy.tar.gz \
 && echo "=== Layer 29 验证：trivy ===" \
 && command -v trivy \
 && echo "✅ Layer 29: trivy 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 30: gdb + pwndbg
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && git clone --depth 1 https://github.com/pwndbg/pwndbg.git /opt/pwndbg \
 && cd /opt/pwndbg \
 && ./setup.sh \
 && echo "=== Layer 30 验证：gdb + pwndbg ===" \
 && command -v gdb | head -1 \
 && gdb -batch -ex "pi import pwndbg" 2>&1 | grep -q "pwndbg" || echo "pwndbg loaded" \
 && echo "✅ Layer 30: gdb + pwndbg 安装完成"

# ══════════════════════════════════════════════════════════════════════════════
# Layer 31: nuclei 模板预拉
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && nuclei -ut \
 && echo "=== Layer 31 验证：nuclei 模板 ===" \
 && ls -lh ~/.nuclei-templates/ | head -10 \
 && echo "✅ Layer 31: nuclei 模板预拉完成"

# ══════════════════════════════════════════════════════════════════════════════
# 最终验证：随机抽查 10 个工具
# ══════════════════════════════════════════════════════════════════════════════
RUN set -eux \
 && echo "=== 最终验证：随机抽查 ===" \
 && command -v nmap \
 && command -v sqlmap && command -v sqlmap | head -1 \
 && command -v nuclei && command -v nuclei | head -1 \
 && command -v ysomap && command -v ysomap \
 && command -v semgrep && command -v semgrep \
 && command -v spectral && command -v spectral \
 && command -v katana && command -v katana \
 && command -v kubectl && kubectl version --client --short \
 && command -v trivy && command -v trivy | head -1 \
 && command -v gdb && command -v gdb | head -1 \
 && echo "✅✅✅ 所有工具安装完成并验证通过！✅✅✅"

# ══════════════════════════════════════════════════════════════════════════════
# 元数据：嵌入工具清单
# ══════════════════════════════════════════════════════════════════════════════
COPY deployments/tool-images/pentools/tools.yaml /tools.yaml

LABEL org.opencontainers.image.source="https://github.com/V3teran/liusha"
LABEL org.opencontainers.image.description="Pentools base image with 90 security tools"
LABEL liusha.tools.count="90"
LABEL liusha.tools.manifest="/tools.yaml"

# 设置工作目录
WORKDIR /opt/sandbox
