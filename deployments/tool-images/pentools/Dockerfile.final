# syntax=docker/dockerfile:1.7
# pentools：liusha 沙箱镜像（基于 pentools-base）- 简化测试版

# 全局 ARG（在所有 FROM 之前声明，才能在多个 stage 中使用）
ARG BASE_IMAGE=ghcr.io/v3teran/pentools-base:latest

# ── Stage 0: 编译 sandbox-server ─────────────────────────────────────────────
FROM golang:1.25-alpine AS sandbox-builder
WORKDIR /src
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY cmd/sandbox-server cmd/sandbox-server
COPY internal/sandbox internal/sandbox
ENV CGO_ENABLED=0
RUN go build -mod=vendor -o /out/sandbox-server ./cmd/sandbox-server

# ── Stage 1: 基于 base 镜像构建最终镜像 ──────────────────────────────────────
# 在 stage 内部重新声明 ARG（multi-stage build 要求）
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# 测试：只添加一个简单文件，看能否成功
RUN echo "pentools final image test" > /tmp/build-test.txt

# Layer 14: sandbox-server 二进制
COPY --from=sandbox-builder /out/sandbox-server /usr/local/bin/sandbox-server
RUN chmod +x /usr/local/bin/sandbox-server && test -x /usr/local/bin/sandbox-server

WORKDIR /work
EXPOSE 8080
CMD ["/usr/local/bin/sandbox-server"]
