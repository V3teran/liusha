# syntax=docker/dockerfile:1.7
# pentools：liusha 沙箱镜像（基于 pentools-base）
#
# 基于 pentools-base 基础镜像，只添加：
#   - sandbox-server 二进制（Stage 0 编译）
#   - browser-use/browser-svc.py 薄客户端脚本
#   - entrypoint 脚本
#
# 构建时间：~2-3 分钟（base 镜像完全缓存）
# 镜像大小：与 base 相同 + sandbox-server (~20MB)

# 全局 ARG（在所有 FROM 之前声明，才能在多个 stage 中使用）
ARG BASE_IMAGE=ghcr.io/v3teran/pentools-base:latest

# ── Stage 0: 编译 sandbox-server ─────────────────────────────────────────────
FROM golang:1.25-alpine AS sandbox-builder
WORKDIR /src
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY cmd/sandbox-server cmd/sandbox-server
COPY internal/sandbox internal/sandbox
COPY internal/logx internal/logx
ENV CGO_ENABLED=0
RUN go build -mod=vendor -o /out/sandbox-server ./cmd/sandbox-server

# ── Stage 1: 基于 base 镜像构建最终镜像 ──────────────────────────────────────
# 在 stage 内部重新声明 ARG（multi-stage build 要求）
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Layer 7: browser-use 薄客户端（覆盖 base 中的占位符）
COPY deployments/tool-images/pentools/browser-use /usr/local/bin/browser-use
COPY deployments/tool-images/pentools/browser-svc.py /usr/local/bin/browser-svc.py
RUN chmod +x /usr/local/bin/browser-use /usr/local/bin/browser-svc.py

# Layer 12: uvx 入口——base 只装了 uv；browser_use 的 LocalBrowserWatchdog 启动浏览器时
# spawn `uvx`。uvx 真实语义 = `uv tool run`（uv 二进制按 argv[0] 分发，symlink 无效），用 wrapper。
RUN printf '%s\n' \
  '#!/bin/sh' \
  'exec /usr/local/bin/uv tool run "$@"' \
  > /usr/local/bin/uvx \
 && chmod +x /usr/local/bin/uvx

# Layer 12.5: 预装 playwright chromium——browser_use 首次启动即用，免运行时 114MB 下载
# （离线/弱网沙箱下 browser_use 会因下载失败全挂）。装失败不阻断镜像构建（浏览器非必需能力）。
RUN /usr/local/bin/uvx playwright install chromium || echo "WARN: chromium 预装失败，运行时将按需下载"

# Layer 13: entrypoint（抓流架构只保留 browser-svc.py 的 CDP capture——CLI 流量不进表）
RUN printf '%s\n' \
  '#!/bin/sh' \
  'exec /usr/local/bin/sandbox-server' \
  > /usr/local/bin/sandbox-entrypoint.sh \
 && chmod +x /usr/local/bin/sandbox-entrypoint.sh

# Layer 14: sandbox-server 二进制
COPY --from=sandbox-builder /out/sandbox-server /usr/local/bin/sandbox-server
RUN chmod +x /usr/local/bin/sandbox-server && test -x /usr/local/bin/sandbox-server

WORKDIR /work
EXPOSE 8080
CMD ["/usr/local/bin/sandbox-entrypoint.sh"]
