# Binaries
/bin/
cmd/*/dist/
*.exe
*.test
*.out

# Local env
.env
.env.local
.env.*.local
.env.docker
# .env 备份（含密钥，绝不入 git）
.env*.bak
.env*.bak-*

# Editor
.vscode/
.idea/
.DS_Store

# 前端构建产物（web/ 源码同仓，dist 由 nginx 镜像多阶段构建生成，不入 git）
web/dist/
web/node_modules/

# Coverage
coverage.out
coverage.html

# cmd/* 二进制在仓库根目录的游离副本（`go build ./cmd/<x>` 默认输出于此）
/api
/cmd/api/api
/agent-worker
/vulnapp
/e2e
/proxy
/runner

# 本地调试产物（截图、playwright MCP 转储）
/llm-view-*.png
/.playwright-mcp/

# 第三方参考资料（设计已提炼到本地 docs/hks2.md / spec / plan，原始资料不入 git）
/docs/Tsec-Hackathon-main/
/docs/hks2.md
/docs/无径之径*

# session runtime store（result_compress middleware 落盘目录）
/session-store/

# Runtime logs / pids（host 进程 + proxify 流量 dump，每次 dev 启动覆盖）
/logs/
# 各 package 测试落盘的本地 log 目录
**/logs/

# Claude Code 本地会话状态
/.claude/

# pentools build context 的 CA cert（运行时从 $HOME/.liusha/cacert.pem 同步进来，不入 git）
deployments/tool-images/pentools/liusha-ca.crt

# Python 字节码缓存（browser-svc.py 等运行时生成）
__pycache__/
*.pyc

# 本地运行日志（go run 的 stdout/stderr 重定向产物）
/asynq.log
/runner.log
/e2e-test.log

# 历史备份/一次性产物不入库
*.bak
*.backup
*.old

# go build 游离二进制（补充）
/liusha-runner
/corpus-import

# ZCode 会话工作目录
/.zcode/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
