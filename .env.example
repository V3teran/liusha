# liusha 环境变量模板（compose 部署与本地开发共用）：复制为仓库根的 .env 并填写；.env 已被
# git 忽略，不要提交。二进制部署不用本文件，用 liusha setup 生成的环境变量文件。

# ---- 必填（缺失 compose 拒绝启动）----
# 数据库密码（openssl rand -hex 16）
POSTGRES_PASSWORD=
# Redis 密码（openssl rand -hex 16）
REDIS_PASSWORD=
# 沙盒与 runner / api 的共享密钥（openssl rand -hex 32）
LIUSHA_SANDBOX_TOKEN=
# LLM 密钥加密密钥：32 字节 hex（openssl rand -hex 32）。生成后不要更改，否则已保存的 LLM 密钥无法解密
LIUSHA_LLM_KEY_SECRET=
# 初始管理员密码（8-72 字节）：仅首次启动创建 admin 时使用，之后在控制台改密
LIUSHA_ADMIN_INITIAL_PASSWORD=

# ---- 回连（需要反弹 shell / 托管 payload 时填写）----
# 目标回连地址：宿主对目标可达的 IP 或域名，payload 里写它
LIUSHA_SANDBOX_CALLBACK_HOST=
# 对外监听段（沙盒发布到宿主同号端口，防火墙按段放行）
#LIUSHA_SANDBOX_LISTENER_PORTS=21000-21099

# ---- 可选 ----
# 经 HTTPS 访问控制台时设 true（会话 Cookie 加 Secure）
#LIUSHA_API_COOKIE_SECURE=true
# 知识库 embedding 密钥：留空则知识库只做关键词检索
#JINA_API_KEY=
# 任务工作区留存天数：0 = 永久保留
#LIUSHA_SANDBOX_WORKSPACE_RETENTION_DAYS=0
# 其他配置项按 LIUSHA_<键> 设置（键见 internal/config/config.yaml），compose 中需在服务的
# environment 里引用；或挂载覆盖文件并设 LIUSHA_CONFIG。
# LLM 接入在控制台「LLM 配置」页完成，密钥加密保存在数据库。

# ---- 数据与端口（缺省值见注释）----
#HOST_DATA_DIR=$HOME/data/liusha
#NGINX_HOST_PORT=50080
#PROXY_HOST_PORT=58588
#API_HOST_PORT=58580
#SANDBOX_HOST_PORT=58591
#POSTGRES_HOST_PORT=55432
#REDIS_HOST_PORT=56379
# 镜像：缺省 ghcr.io/v3teran/liusha:<当前检出代码对应的版本>
#LIUSHA_IMAGE_REPO=ghcr.io/v3teran
#LIUSHA_IMAGE_TAG=
