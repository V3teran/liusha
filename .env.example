# Liusha 环境变量模板：复制为 .env（仓库根）并填真实值；.env 已 gitignore，绝不提交。
# Docker 部署只需【Docker】两区；其余仅 host 开发形态（run-svc.sh / e2e.sh）消费，Docker 下填了不生效。

# ---- Docker：必填 4 项（缺失 compose 拒起）----

# 数据库密码（openssl rand -hex 16）
POSTGRES_PASSWORD=changeme-pg-pass
# redis 密码（openssl rand -hex 16）
REDIS_PASSWORD=changeme-redis-pass
# 初始管理员密码（8-72 字节，openssl rand -base64 24）：仅首次启动建 admin 时生效，之后走前端改密
LIUSHA_ADMIN_INITIAL_PASSWORD=changeme-admin-pass
# provider 密钥加密密钥（AES-256-GCM 32 字节 hex，openssl rand -hex 32）
LIUSHA_LLM_KEY_SECRET=changeme-32-bytes-hex

# ---- Docker：模型配置（非启动前提）----
# 出厂种子一块 glm 部署（config.yaml providers.glm，三档推理全路由到它）：填 key 即可用。
# 不填也能启动：任务下发会被拒绝并提示到前端「LLM 配置」页接入。
# 换/加厂商两条路：
#   前端（推荐）：「LLM 配置」页新建 provider（协议可选 OpenAI 兼容 / Anthropic）+ 绑能力路由；
#   部署期：改 config.yaml providers 块 + 此处放同名 key（api_key_env 钉定变量名），首次启动自动导入。
GLM_API_KEY=

# ---- Docker：可选 ----
# 沙箱流量回灌的 Bearer token：公网宿主必填（runner 与沙盒自动共享同一值）；空 = 不验证（仅本机开发）
LIUSHA_INGEST_TOKEN=
# 会话 Cookie Secure 属性：HTTPS 反代设 true；纯 http 留空
LIUSHA_COOKIE_SECURE=
# embedding 密钥：空 = corpus 降级纯 sparse 检索
JINA_API_KEY=

# 宿主端口（缺省即注释值）：撞端口时覆盖，勿改 compose.yaml（升级 git pull 不冲突）。
#   前端 50080 / api 58580 / 代理 58588 / 回灌 58590 / pg 55432 / redis 56379
#NGINX_HOST_PORT=50080
#API_HOST_PORT=58580
#PROXY_HOST_PORT=58588
#RUNNER_HOST_PORT=58590
#POSTGRES_HOST_PORT=55432
#REDIS_HOST_PORT=56379
# 镜像仓库/标签（缺省 ghcr.io/v3teran 与 latest）。latest = 最新正式版；可固定版本号
# （如 0.4.1，或 0.4 跟随该小版本补丁）。沙盒镜像随同一 tag 拉取，与业务镜像版本一致
LIUSHA_IMAGE_REPO=
LIUSHA_IMAGE_TAG=
# 持久化数据根（缺省 ~/data/liusha）；沙盒工作区缺省在其下 workspace/
HOST_DATA_DIR=
HOST_WORKSPACE_DIR=

# viper 旋钮覆盖（键必须先在 config.yaml 落名）：
#LIUSHA_CONVERSATION_ATTACHMENT_MAX_BYTES=104857600   # 单附件上限（缺省 100 MiB）
#LIUSHA_SANDBOX_WORKSPACE_RETENTION_DAYS=             # 沙盒工作区留存天数（0 = 永久）

# ---- 仅 host 开发形态（Docker 部署忽略）----

LIUSHA_POSTGRES_DSN=postgres://liusha:liusha@localhost:55432/liusha?sslmode=disable
# ↑ 密码须与 POSTGRES_PASSWORD 一致（compose 形态自动拼接，无需手改）
LIUSHA_REDIS_ADDR=localhost:56379
LIUSHA_API_ADDR=0.0.0.0:8580
LIUSHA_ENV=development
LIUSHA_LOG_LEVEL=info
LIUSHA_CONFIG=./config/config.yaml
