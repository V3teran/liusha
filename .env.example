# liusha 环境变量模板：二进制、单镜像、多镜像三种部署方式共用这一份。复制为 .env 并填写；
# .env 含密钥，不要提交（仓库里已被 git 忽略）。
#   - 二进制：与 liusha、config.yaml 放在同一目录，启动时显式读入：liusha serve -env-file .env
#     （systemd 用 EnvironmentFile=<该文件>）。
#   - 单镜像：docker run --env-file .env …（make single-run 已含）。
#   - 多镜像：放在仓库根目录（与 compose.yaml 同目录），docker compose 自动读取。
#
# 只放密钥与部署需要的变量，其余配置在 config.yaml 里。变量一律以 LIUSHA_ 开头：
#   - 名字对上配置键的（LIUSHA_<键>，如 LIUSHA_LLM_ENCRYPTION_KEY 对应 llm.encryption_key）由 liusha
#     读取，覆盖 config.yaml 里的值；
#   - 其余是部署变量，给容器与 docker compose 用（自带数据库的密码、宿主端口、镜像等），liusha 不读。
# 密钥与密码用 openssl rand -hex 生成（只含十六进制字符，放进连接串无需转义）。

# ---- 密钥（必填，各部署方式共用）----
# 沙盒与 runner / api 的共享密钥（openssl rand -hex 32）
LIUSHA_SANDBOX_TOKEN=
# 加密数据库里保存的全部模型密钥（对话 provider 与检索模型）：32 字节 hex（openssl rand -hex 32）。生成后不要更改，否则已保存的密钥无法解密
LIUSHA_LLM_ENCRYPTION_KEY=
# 初始管理员密码（8-72 字节）：仅首次启动创建 admin 时使用，之后在控制台改密
LIUSHA_ADMIN_INITIAL_PASSWORD=

# ---- 可选：网页检索后端的密钥（接入方法见 config.yaml 的 web_search 段）----
# 搜索接口要鉴权时填它的密钥（配置键 web_search.api_key）
#LIUSHA_WEB_SEARCH_API_KEY=

# ---- 二进制：连接已有的 PostgreSQL（需已安装 pgvector 扩展）与 Redis，取消注释并填写 ----
#LIUSHA_POSTGRES_URL=postgres://liusha:<密码>@127.0.0.1:5432/liusha?sslmode=disable
#LIUSHA_REDIS_URL=redis://:<密码>@127.0.0.1:6379/0

# ---- 单镜像 / 多镜像：取消注释并填写（必填）----
# 自带的 PostgreSQL / Redis 的密码（openssl rand -hex 16）；liusha 的连接串由容器按它们拼出
#LIUSHA_POSTGRES_PASSWORD=
#LIUSHA_REDIS_PASSWORD=
# 对外监听段（配置键 sandbox.listener_ports）：容器要按它发布同号端口，发布须在启动前确定，所以
# 容器部署在这里写定（覆盖 config.yaml）；防火墙按段放行
#LIUSHA_SANDBOX_LISTENER_PORTS=21000-21299

# ---- 单镜像 / 多镜像：宿主端口（可选，缺省值见注释）----
#LIUSHA_CONSOLE_HOST_PORT=50080
#LIUSHA_PROXY_HOST_PORT=58588
# 客户端连代理用的地址（配置键 proxy.public_addr，控制台「代理接入」显示）：容器部署缺省为
# 「控制台所在主机:LIUSHA_PROXY_HOST_PORT」，控制台与代理不在同一主机时写完整地址
#LIUSHA_PROXY_PUBLIC_ADDR=proxy.example.com:58588

# ---- 仅多镜像（可选，缺省值见注释）----
# 数据目录（配置键 data_dir）：数据都在这里，config.yaml 也放在这里（从仓库的
# internal/config/config.yaml 复制）；容器内以同一路径挂载
#LIUSHA_DATA_DIR=$HOME/data/liusha
# 只绑回环的宿主端口，供宿主上直接运行的开发进程访问
#LIUSHA_SANDBOX_HOST_PORT=58591
#LIUSHA_POSTGRES_HOST_PORT=55432
#LIUSHA_REDIS_HOST_PORT=56379
# 镜像：缺省 ghcr.io/v3teran/liusha:<当前检出代码对应的版本>
#LIUSHA_IMAGE_REPO=ghcr.io/v3teran
#LIUSHA_IMAGE_TAG=
