# ============================================================================
# Liusha 环境变量模板
#   - 复制为 .env（仓库根）并填入真实值；.env 已在 .gitignore，绝不提交
#   - Docker 部署（compose）：只需【Docker 部署】区；其余区由 compose 覆盖或
#     仅 host 开发形态（scripts/dev/run-svc.sh）消费，Docker 下填了也不生效
# ============================================================================

# ---- Docker 部署（compose 插值消费；必填项缺失直接拒起）----
# 必填六项：POSTGRES_PASSWORD / REDIS_PASSWORD / GLM_API_KEY（或所配厂商的 key）、
#           LIUSHA_LLM_KEY_SECRET / LIUSHA_ADMIN_INITIAL_PASSWORD

# 数据库密码（compose 内各服务的 DSN 与之同源；生成：openssl rand -hex 16）
POSTGRES_PASSWORD=changeme-pg-pass
# redis 密码（必填，全链路 requirepass；生成：openssl rand -hex 16）
REDIS_PASSWORD=changeme-redis-pass
# 初始管理员密码（8-72 字节）：仅账号表为空的首次启动生效——api 启动期直接建
# admin 账号；之后改密走前端「修改密码」，本变量被忽略。生成：openssl rand -base64 24
LIUSHA_ADMIN_INITIAL_PASSWORD=changeme-admin-pass
# LLM provider 密钥加密密钥（AES-256-GCM，32 字节 hex）。生成：openssl rand -hex 32
LIUSHA_LLM_KEY_SECRET=changeme-32-bytes-hex
# LLM provider API Key（可选）：仅空库首次种子导入 glm provider 用——不填则跳过
# 种子，启动后在「LLM 配置」页添加任意厂商（openai_compat / anthropic）并设路由
GLM_API_KEY=

# ---- Docker 部署（可选）----
# 宿主端口约定（compose 映射）：一律「5+容器端口」前缀、不足五位补 0——
#   前端 50080 / 代理 58588 / 回灌 58590 / pg 55432 / redis 56379 / api 58580（仅回环）

# embedding 密钥：缺失则 corpus 降级纯 sparse 检索（不影响主流程）
JINA_API_KEY=
# 沙盒流量回灌端点（宿主 58590）的 Bearer token：公网宿主必须设置
# （runner 与沙盒自动共享同一值）；空 = 开发模式不验证
LIUSHA_INGEST_TOKEN=
# 会话 Cookie Secure 属性：HTTPS 反代部署设 true；纯 http 留空（=false，否则浏览器不种）
LIUSHA_COOKIE_SECURE=
# 持久化数据根（缺省 ~/data/liusha）；沙盒工作区缺省在其下 workspace/
HOST_DATA_DIR=
HOST_WORKSPACE_DIR=
# 沙盒工作区留存天数（0 = 永久；正数按目录 mtime 清扫）
WORKSPACE_RETENTION_DAYS=0
# 镜像仓库/标签（缺省 ghcr.io/v3teran 与 latest；自建仓库时覆盖）
LIUSHA_IMAGE_REPO=
LIUSHA_IMAGE_TAG=

# ---- 以下仅 host 开发形态（run-svc.sh / e2e.sh）消费，Docker 部署忽略 ----

LIUSHA_POSTGRES_DSN=postgres://liusha:liusha@localhost:55432/liusha?sslmode=disable
# ↑ host DSN 密码须与 POSTGRES_PASSWORD 一致（compose 形态自动拼接，无需手改）
LIUSHA_REDIS_ADDR=localhost:56379
LIUSHA_API_ADDR=0.0.0.0:8580
LIUSHA_ENV=development
LIUSHA_LOG_LEVEL=info
LIUSHA_CONFIG=./config/config.yaml
