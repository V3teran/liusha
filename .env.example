# ============================================================================
# Liusha 环境变量模板
#   - 复制为 .env（仓库根）并填入真实 key
#   - .env 已在 .gitignore，绝不提交；docker compose（docker-compose.yml 在仓库根，
#     插值自动加载）与 host 脚本（run-svc.sh / e2e.sh source）消费同一份文件
# ============================================================================

# ---- 基础 ----
LIUSHA_POSTGRES_DSN=postgres://liusha:liusha@localhost:5432/liusha?sslmode=disable
LIUSHA_REDIS_ADDR=localhost:6379
LIUSHA_API_ADDR=0.0.0.0:8090
LIUSHA_API_KEY=changeme-dev-key
# SSE stream cookie 签名密钥（会话流鉴权）；**缺失 api 会 fail-fast**。生成：openssl rand -hex 32
LIUSHA_STREAM_COOKIE_SECRET=changeme-32-bytes-hex
# cookie Secure 属性：prod HTTPS 反代设 true；dev http 同源留空（=false，否则浏览器不种 cookie）
LIUSHA_COOKIE_SECURE=
LIUSHA_ENV=development
LIUSHA_LOG_LEVEL=info
LIUSHA_CONFIG=./config/config.yaml

# provider API Key 加密密钥（migration 0103，AES-256-GCM，32 字节 hex）。
# 生成：openssl rand -hex 32。fail-fast：缺失/长度不对 api/runner/corpus-import 直接拒启动。
LIUSHA_LLM_KEY_SECRET=changeme-32-bytes-hex

# ---- Provider API Key（仅供空库首次种子导入 / api_key_env 回退；DB 加密落库后不依赖）----
GLM_API_KEY=your-glm-api-key-here

# ---- Jina embedding（lesson→RAG 检索用）----
JINA_API_KEY=jina_your-key-here
